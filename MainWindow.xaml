<Window x:Class="ScreenRecorderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V Rec" Height="110" Width="620"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" Foreground="White" 
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    
    <Border CornerRadius="8" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Draggable Title Bar -->
            <Border Grid.Row="0" Background="#000000" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="V REC" VerticalAlignment="Center" Margin="15,0" FontWeight="Bold" FontSize="13" Foreground="#E60000"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="?" Width="36" Height="36" Background="Transparent" Foreground="#888" BorderThickness="0" Click="HelpButton_Click" FontSize="14" ToolTip="Shortcuts: Ctrl+Shift+R (Start), P (Pause), S (Stop), D (Draw), A (Area), Esc (Stop Draw)"/>
                        <Button Content="−" Width="36" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" Click="MinimizeToTray_Click" FontSize="18" FontWeight="Bold"/>
                        <Button Content="✕" Width="36" Height="36" Background="#E60000" Foreground="White" BorderThickness="0" Click="Exit_Click" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compact Flat Button Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                
                <Button x:Name="StartRecButton" Width="90" Height="38" Margin="4,0" Background="#E60000" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold" Click="StartRec_Click" ToolTip="Start Recording (Ctrl+Shift+R)">
                    <Button.Content>▶ START</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Width="90" Height="38" Margin="4,0" Background="#333333" Foreground="White" BorderThickness="0" FontSize="13" Click="PauseRec_Click" ToolTip="Pause Recording (Ctrl+Shift+P)">
                    <Button.Content>⏸ PAUSE</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Width="90" Height="38" Margin="4,0" Background="#E60000" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold" Click="StopRec_Click" ToolTip="Stop Recording (Ctrl+Shift+S)">
                    <Button.Content>⏹ STOP</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Width="90" Height="38" Margin="4,0" Background="#333333" Foreground="White" BorderThickness="0" FontSize="13" Click="Draw_Click" ToolTip="Toggle Draw Mode (Ctrl+Shift+D)">
                    <Button.Content>✏️ DRAW</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="SelectAreaButton" Width="90" Height="38" Margin="4,0" Background="#4A90E2" Foreground="White" BorderThickness="0" FontSize="13" Click="SelectArea_Click" ToolTip="Select Recording Area (Ctrl+Shift+A)">
                    <Button.Content>📐 AREA</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="ResetAreaButton" Width="90" Height="38" Margin="4,0" Background="#666666" Foreground="White" BorderThickness="0" FontSize="13" Click="ResetArea_Click" Visibility="Collapsed" ToolTip="Reset to Full Screen">
                    <Button.Content>🔄 RESET</Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            
            <!-- Tiny Status Text -->
            <TextBlock x:Name="StatusText" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" Text="Ready" Foreground="#888888" FontSize="11"/>
        </Grid>
    </Border>
</Window>
