<Window x:Class="ScreenRecorderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V Rec" Height="420" Width="700"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent"
        Foreground="White" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    
    <Border CornerRadius="12" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="#000000" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="V REC | 1080p HD" VerticalAlignment="Center" Margin="20,0" FontWeight="Bold" FontSize="16" Foreground="#E60000"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="−" Width="50" Height="50" Background="Transparent" Foreground="White" BorderThickness="0" Click="MinimizeToTray_Click" FontSize="20" FontWeight="Bold"/>
                        <Button Content="✕" Width="50" Height="50" Background="#E60000" Foreground="White" BorderThickness="0" Click="Exit_Click" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button x:Name="StartRecButton" Height="55" Width="140" Margin="8,0" Background="#E60000" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Click="StartRec_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="START" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Ctrl+Shift+R" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Height="55" Width="140" Margin="8,0" Background="#333333" Foreground="White" BorderThickness="0" FontSize="15" Click="PauseRec_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="PAUSE" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Ctrl+Shift+P" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Height="55" Width="140" Margin="8,0" Background="#E60000" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Click="StopRec_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="STOP" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Ctrl+Shift+S" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Height="55" Width="140" Margin="8,0" Background="#333333" Foreground="White" BorderThickness="0" FontSize="15" Click="Draw_Click">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="DRAW" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Ctrl+Shift+D" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <TextBlock x:Name="StatusText" Grid.Row="1" Text="Initializing..." VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
            </Grid>
            
            <Border Grid.Row="2" Background="#0D0D0D" CornerRadius="0,0,12,12" Padding="20,15">
                <StackPanel>
                    <TextBlock Text="⌨️ Keyboard Shortcuts" FontSize="13" FontWeight="Bold" Foreground="#E60000" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <TextBlock Text="Ctrl+Shift+R = Start  |  " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Ctrl+Shift+P = Pause  |  " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Ctrl+Shift+S = Stop  |  " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Ctrl+Shift+D = Draw  |  " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Esc = Stop Drawing" Foreground="#888888" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
