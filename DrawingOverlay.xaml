<Window x:Class="ScreenRecorderApp.DrawingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowState="Maximized" ShowInTaskbar="False"
        IsHitTestVisible="False"> <!-- Crucial: Allows mouse clicks to pass through to apps -->
    <Canvas x:Name="DrawCanvas" Background="Transparent"/>
</Window>